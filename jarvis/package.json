{
  "name": "jarvis-ai-os",
  "version": "2.0.0",
  "description": "JARVIS — Just A Rather Very Intelligent System. Advanced AI Operating System powered by Ollama.",
  "main": "main.js",
  "scripts": {
    "start": "node build.js && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "ollama:gpu": "powershell -ExecutionPolicy Bypass -File ./start-ollama-gpu.ps1",
    "start:gpu": "powershell -ExecutionPolicy Bypass -Command \"$env:CUDA_VISIBLE_DEVICES='0'; $env:OLLAMA_KEEP_ALIVE='30m'; $env:OLLAMA_NUM_GPU='99'; $env:OLLAMA_FLASH_ATTENTION='1'; electron .\"",
    "build": "node build.js",
    "sign-skills": "node sign-skills.js"
  },
  "keywords": [
    "jarvis",
    "ai",
    "ollama",
    "electron",
    "llm"
  ],
  "author": "JARVIS Systems",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.15",
    "electron": "44.4.3",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "acorn": "^8.17.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.9.0",
    "marked": "^9.1.6",
    "playwright": "^1.63.0",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  }
}
