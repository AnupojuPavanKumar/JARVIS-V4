{
  "name": "jarvis-ai-os",
  "productName": "JARVIS",
  "version": "2.0.0",
  "description": "JARVIS - Just A Rather Very Intelligent System. Advanced AI Operating System powered by Ollama.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package:win": "electron-builder --win --x64 --dir",
    "package:win:installer": "electron-builder --win --x64",
    "test": "node --test",
    "test:electron": "electron tests/electron-renderer-smoke.js && electron tests/electron-agent-smoke.js && electron tests/electron-phase1-smoke.js && electron tests/electron-phase2-smoke.js && electron tests/electron-main-smoke.js && electron tests/electron-phase4-smoke.js",
    "eval:phase3": "node scripts/phase3-eval.js",
    "eval:phase3:real": "node scripts/phase3-eval.js --real",
    "ollama:gpu": "powershell -ExecutionPolicy Bypass -File ./start-ollama-gpu.ps1",
    "start:gpu": "powershell -ExecutionPolicy Bypass -Command \"$env:CUDA_VISIBLE_DEVICES='0'; $env:OLLAMA_KEEP_ALIVE='10m'; $env:OLLAMA_NUM_GPU='99'; $env:OLLAMA_FLASH_ATTENTION='1'; electron .\"",
    "sign-skills": "node sign-skills.js"
  },
  "keywords": [
    "jarvis",
    "ai",
    "ollama",
    "electron",
    "llm"
  ],
  "author": "JARVIS Systems",
  "license": "MIT",
  "dependencies": {
    "@vladmandic/human": "3.3.6",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.9.0",
    "marked": "^9.1.6",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.jarvis.aios",
    "productName": "JARVIS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "!tests/**",
      "!scripts/**",
      "!dist/**",
      "!**/*.log"
    ],
    "asarUnpack": [
      "bin/**",
      "skills/**",
      "renderer/vendor/human/models/**",
      "start-ollama-gpu.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
